  "item": [
    {
      "name": "01. Auth & RBAC",
      "item": [
        {
          "name": "Health Check (/healthz)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/healthz"
          }
        },
        {
          "name": "Login (Auto-capture {{token}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body && body.isSuccess && body.data && body.data.token) {",
                  "  pm.environment.set('token', body.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/Auth/login"
          }
        },
        {
          "name": "List Users (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/Users/list"
          }
        },
        {
          "name": "Create User (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"staff_demo\",\n  \"email\": \"staff_demo@smartwms.local\",\n  \"password\": \"REPLACE_WITH_TEMP_PASSWORD\",\n  \"lastName\": \"Warehouse\",\n  \"firstName\": \"Staff\",\n  \"role\": \"Staff\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/Users"
          }
        }
