# Copy to .env.local for real ASP.NET authentication + one inventory summary read.
VITE_DATA_MODE=api
# Public backend origin only; exact /api/v1 routes are appended by the shared client.
VITE_API_BASE_URL=http://localhost:5215
# npm run dev:demo explicitly selects .env.demo (synthetic auth/data).
# No JWT secret, provider key, or database configuration belongs here.
