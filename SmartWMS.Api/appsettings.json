{
  "DatabaseInitialization": {
    "ApplyMigrationsOnStartup": false,
    "SeedOnStartup": false,
    "AllowedMigrationEnvironments": [ "Development" ]
  },
  "Hangfire": {
    "EnableServer": false,
    "RegisterRecurringJobsOnStartup": false,
    "PrepareSchemaIfNecessary": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
