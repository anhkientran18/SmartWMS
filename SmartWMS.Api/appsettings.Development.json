{
  "DatabaseInitialization": {
    "ApplyMigrationsOnStartup": false,
    "SeedOnStartup": false,
    "AllowedMigrationEnvironments": [ "Development" ]
  },
  "Hangfire": {
    "EnableServer": false,
    "RegisterRecurringJobsOnStartup": false,
    "PrepareSchemaIfNecessary": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SmartWMS_DB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "HangfireConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SmartWMS_DB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "SmartWMS.Api",
    "Audience": "SmartWMS.Client",
    "ExpiryInDays": 7
  },
  "GeminiSettings": {
    "ApiKey": "",
    "DefaultModel": "gemini-1.5-flash",
    "ProModel": "gemini-1.5-pro",
    "EmbeddingModel": "gemini-embedding-001",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta"
  }
}
